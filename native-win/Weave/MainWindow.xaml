<Window x:Class="Weave.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="织影 Weave" Width="1240" Height="780" MinWidth="820" MinHeight="560"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"
        PreviewMouseDown="Window_PreviewMouseDown" PreviewKeyDown="Window_PreviewKeyDown">
  <Grid>
    <!-- 登录 -->
    <Grid x:Name="LoginPane" Visibility="Collapsed">
      <Border Background="{StaticResource Panel}" CornerRadius="12" Padding="28" Width="380" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel>
          <TextBlock Text="织影" FontSize="30" FontWeight="Bold" Margin="0,0,0,4"/>
          <TextBlock Text="连接你的 Emby 服务器" Foreground="{StaticResource Muted}" Margin="0,0,0,18"/>
          <TextBlock Text="服务器地址" Foreground="{StaticResource Muted}" Margin="0,0,0,4"/>
          <TextBox x:Name="ServerBox" Margin="0,0,0,12"/>
          <TextBlock Text="用户名" Foreground="{StaticResource Muted}" Margin="0,0,0,4"/>
          <TextBox x:Name="UserBox" Margin="0,0,0,12"/>
          <TextBlock Text="密码" Foreground="{StaticResource Muted}" Margin="0,0,0,4"/>
          <PasswordBox x:Name="PassBox" Margin="0,0,0,16" KeyDown="PassBox_KeyDown"/>
          <Button x:Name="LoginBtn" Content="登录" Click="Login_Click"/>
          <TextBlock x:Name="LoginErr" Foreground="#FF6B6B" TextWrapping="Wrap" Margin="0,12,0,0"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- 主界面 -->
    <Grid x:Name="MainPane" Visibility="Collapsed">
      <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="{StaticResource Panel}">
        <DockPanel Margin="10">
          <TextBlock DockPanel.Dock="Top" Text="织影" FontSize="22" FontWeight="Bold" Margin="8,6,0,14"/>
          <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0" SelectionChanged="Nav_SelectionChanged"
                   Foreground="{StaticResource Fg}">
            <ListBox.ItemTemplate>
              <DataTemplate><TextBlock Text="{Binding Name}" Padding="8,8" FontSize="14"/></DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
      <Grid Grid.Column="1" Margin="18,10,8,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
          <Button x:Name="BackBtn" Content="←  返回" Background="#2A2E39" Padding="12,6" Margin="0,0,14,0" Visibility="Collapsed" Click="Back_Click"/>
          <TextBlock x:Name="PageTitle" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
        <ContentControl x:Name="Host" Grid.Row="1"/>
      </Grid>
    </Grid>
  </Grid>
</Window>
