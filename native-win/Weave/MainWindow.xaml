<Window x:Class="Weave.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="织影 Weave" Width="1180" Height="740" MinWidth="760" MinHeight="520"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">
  <Grid>
    <!-- 登录 -->
    <Grid x:Name="LoginPane" Visibility="Collapsed">
      <Border Background="{StaticResource Panel}" CornerRadius="12" Padding="28" Width="380" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel>
          <TextBlock Text="织影" FontSize="30" FontWeight="Bold" Margin="0,0,0,4"/>
          <TextBlock Text="连接你的 Emby 服务器" Foreground="{StaticResource Muted}" Margin="0,0,0,18"/>
          <TextBlock Text="服务器地址" Foreground="{StaticResource Muted}" Margin="0,0,0,4"/>
          <TextBox x:Name="ServerBox" Margin="0,0,0,12"/>
          <TextBlock Text="用户名" Foreground="{StaticResource Muted}" Margin="0,0,0,4"/>
          <TextBox x:Name="UserBox" Margin="0,0,0,12"/>
          <TextBlock Text="密码" Foreground="{StaticResource Muted}" Margin="0,0,0,4"/>
          <PasswordBox x:Name="PassBox" Margin="0,0,0,16" KeyDown="PassBox_KeyDown"/>
          <Button x:Name="LoginBtn" Content="登录" Click="Login_Click"/>
          <TextBlock x:Name="LoginErr" Foreground="#FF6B6B" TextWrapping="Wrap" Margin="0,12,0,0"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- 主界面 -->
    <Grid x:Name="MainPane" Visibility="Collapsed">
      <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="{StaticResource Panel}">
        <DockPanel Margin="10">
          <TextBlock DockPanel.Dock="Top" Text="织影" FontSize="22" FontWeight="Bold" Margin="8,6,0,14"/>
          <Button DockPanel.Dock="Bottom" Content="退出登录" Background="#2A2E39" Click="Logout_Click"/>
          <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0" SelectionChanged="Nav_SelectionChanged"
                   Foreground="{StaticResource Fg}">
            <ListBox.ItemTemplate>
              <DataTemplate><TextBlock Text="{Binding Name}" Padding="8,7" FontSize="14"/></DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
      <Grid Grid.Column="1" Margin="18,14,8,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock x:Name="PageTitle" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <TextBlock x:Name="Status" Grid.Row="1" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <ListBox x:Name="Grid2" Grid.Row="1" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="Grid2_DoubleClick">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Width="150" Margin="6,6,6,12">
                <Border Width="150" Height="225" CornerRadius="6" Background="#242832">
                  <Border.Clip><RectangleGeometry Rect="0,0,150,225" RadiusX="6" RadiusY="6"/></Border.Clip>
                  <Image Source="{Binding Poster}" Stretch="UniformToFill"/>
                </Border>
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" FontSize="13"/>
                <TextBlock Text="{Binding Sub}" Foreground="{StaticResource Muted}" FontSize="12"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Grid>
  </Grid>
</Window>
