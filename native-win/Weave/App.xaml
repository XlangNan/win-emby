<Application x:Class="Weave.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Bg" Color="#14161B"/>
    <SolidColorBrush x:Key="Panel" Color="#1C1F26"/>
    <SolidColorBrush x:Key="Fg" Color="#E8EAEE"/>
    <SolidColorBrush x:Key="Muted" Color="#8B91A0"/>
    <SolidColorBrush x:Key="Accent" Color="#4C8DFF"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Fg}"/></Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#242832"/><Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="BorderBrush" Value="#323744"/><Setter Property="Padding" Value="8,6"/><Setter Property="CaretBrush" Value="White"/>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Background" Value="#242832"/><Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="BorderBrush" Value="#323744"/><Setter Property="Padding" Value="8,6"/><Setter Property="CaretBrush" Value="White"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16,8"/><Setter Property="Cursor" Value="Hand"/>
    </Style>
  </Application.Resources>
</Application>
