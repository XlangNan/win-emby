{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Win-Emby",
  "version": "0.1.0",
  "identifier": "com.winemby.app",
  "build": {
    "beforeDevCommand": "pnpm run web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Win-Emby",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "decorations": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"]
      }
    }
  }
}
