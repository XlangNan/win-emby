{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "织影",
  "version": "0.2.0",
  "identifier": "com.weave.player",
  "build": {
    "beforeDevCommand": "pnpm run web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "织影",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "decorations": false,
        "resizable": true,
        "center": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": [
          "SimpChinese"
        ]
      }
    },
    "resources": [
      "lib/**/*"
    ]
  }
}
